<configuration>
  <!-- Pola log di praktik BisaNgoding: tanpa jam dan nama thread supaya keluaran bisa dicek. -->
  <conversionRule conversionWord="exSingkat" converterClass="com.bisangoding.log.PengecualianSingkat"/>
  <appender name="KONSOL" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger{36}%replace( [%mdc]){' \[\]', ''} - %msg%n%exSingkat</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="KONSOL"/>
  </root>
</configuration>
